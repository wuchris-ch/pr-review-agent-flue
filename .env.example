# OpenAI-compatible gateway configuration
MODEL_GATEWAY_API_KEY=replace-with-your-api-key
MODEL_GATEWAY_BASE_URL=https://gateway.example/v1
REVIEW_AGENT_MODEL=replace-with-your-model-id

# Optional OpenTelemetry configuration
# OTEL_SERVICE_NAME=pr-review-agent-flue
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional watcher settings. Leave unset until you intend to start npm run watch.
# GITHUB_TOKEN=replace-with-a-token
# GITHUB_REPOSITORIES=owner/repository
# REVIEW_POLL_INTERVAL_SECONDS=60
