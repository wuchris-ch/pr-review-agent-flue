{
  "name": "@wuchris-ch/pr-review-agent-flue",
  "version": "0.2.1",
  "description": "Evidence-grounded pull request reviews from your terminal, GitHub Actions, or a GitHub App.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pr-review-flue": "dist/review.js",
    "pr-review-flue-pr": "dist/pr.js",
    "pr-review-flue-agent": "dist/cli.js",
    "pr-review": "dist/bin/main.js",
    "pr-review-pr": "dist/pr.js",
    "pr-review-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "review": "node --env-file-if-exists=.env dist/cli.js",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:smoke": "node --env-file-if-exists=.env scripts/run-eval.mjs --set smoke",
    "eval:full": "node --env-file-if-exists=.env scripts/run-eval.mjs --set full",
    "eval:holdout": "node --env-file-if-exists=.env scripts/run-eval.mjs --set holdout",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "cli": "node --env-file-if-exists=.env dist/bin/main.js",
    "examples:check": "python3 scripts/examples/check-scenarios.py",
    "eval:compare": "node --env-file-if-exists=.env scripts/compare-pipeline.mjs",
    "eval:import": "node scripts/import-external-benchmark.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^22.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchris-ch/pr-review-agent-flue.git"
  }
}
